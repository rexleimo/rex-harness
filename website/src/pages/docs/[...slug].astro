---
import { getCollection, render } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { groupLabels, docsPath } from '../../i18n/docs';
import DocsLayout from '../../components/DocsLayout.astro';

const lang = 'en' as Lang;

export async function getStaticPaths() {
  const entries = await getCollection('docs', (e) => e.id.startsWith('en/') && e.id !== 'en/providers');
  return entries.map((e) => ({ params: { slug: e.id.replace('en/', '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const all = (await getCollection('docs', (e) => e.id.startsWith(`${lang}/`)))
  .map((e) => ({ slug: e.id.replace(`${lang}/`, ''), ...e.data }))
  .sort((a, b) => a.order - b.order);
const idx = all.findIndex((d) => d.slug === entry.id.replace(`${lang}/`, ''));
const toNav = (d?: (typeof all)[number]) => (d ? { title: d.title, href: docsPath(lang, d.slug) } : undefined);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = `${base}/docs/${entry.id.replace('en/', '')}/`;
---
<DocsLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  pathname={pathname}
  headings={headings}
  prev={toNav(all[idx - 1])}
  next={toNav(all[idx + 1])}
  groupLabel={groupLabels[entry.data.group][lang]}
  updated={entry.data.updated}
>
  <Content />
</DocsLayout>
