---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { docsPath } from '../i18n/docs';

const { lang }: { lang: Lang } = Astro.props;
---
<aside class="not-prose border-primary/30 bg-primary/5 my-10 flex flex-col gap-5 rounded-xl border p-6 sm:p-8">
  <div class="flex flex-col gap-2">
    <span class="font-mono text-[11px] font-medium leading-[1.4] tracking-normal text-primary">{t(lang, 'cta.kicker')}</span>
    <h3 class="text-[1.3125rem] font-bold leading-[1.15] tracking-[-0.02em] sm:text-[1.5rem] sm:tracking-[-0.022em] text-foreground text-balance font-sans">{t(lang, 'cta.title')}</h3>
    <p class="text-[17px] font-normal leading-[1.55] sm:text-[18.5px] text-foreground/80 text-balance">{t(lang, 'cta.body')}</p>
  </div>
  <div class="flex flex-wrap gap-3">
    <a class="bg-accent-fill text-accent-fill-foreground hover:bg-accent-fill-hover inline-flex h-11 items-center justify-center rounded-[9px] px-5 text-sm font-bold transition-colors" href={docsPath(lang, 'getting-started')}>{t(lang, 'cta.docs')}</a>
    <a class="border-input hover:border-foreground/30 inline-flex h-11 items-center justify-center gap-2 rounded-[9px] border px-5 text-sm font-bold transition-colors" href="https://github.com/rexleimo/rex-harness">{t(lang, 'cta.star')}</a>
  </div>
</aside>
