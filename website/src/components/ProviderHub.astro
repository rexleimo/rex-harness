---
import type { Lang } from '../i18n/ui';
import { providerGroups, hubCopy } from '../i18n/providers';
import { providerPath } from '../i18n/docs';

const { lang }: { lang: Lang } = Astro.props;
const c = hubCopy;
const CHAIN = `request → rex-requirements → rex-design / rex-wayfinder → rex-planning
        → rex-test-design → rex-tdd | rex-strict-tdd
        → rex-implement | rex-minimal-construction | rex-refactor-hardening
        → rex-debug（观测到失败时抢占）
        → rex-code-review → completed`;
const CHAIN_EN = `request → rex-requirements → rex-design / rex-wayfinder → rex-planning
        → rex-test-design → rex-tdd | rex-strict-tdd
        → rex-implement | rex-minimal-construction | rex-refactor-hardening
        → rex-debug (preempts on observed failure)
        → rex-code-review → completed`;
---
<div class="px-[18px] pb-16 pt-10 sm:px-11 md:pb-20 md:pt-12">
  <div class="mx-auto max-w-[860px]">
    <!-- Hero -->
    <p class="font-mono text-[11px] font-medium leading-[1.4] tracking-normal text-primary mb-3">{c.eyebrow[lang]}</p>
    <h1 class="text-[1.75rem] font-bold leading-[1.12] tracking-[-0.028em] sm:text-[2.125rem] text-balance">{lang === 'zh' ? 'Provider 目录' : 'Provider Catalog'}</h1>
    <p class="text-[15px] leading-[1.6] mt-3 max-w-[68ch] text-pretty text-[color:var(--ah-fg-muted)]">{c.intro[lang]}</p>
    <p class="font-mono text-[12px] leading-[1.5] mt-3 text-muted-foreground">{c.stats[lang]}</p>

    <!-- Install card -->
    <section class="bg-muted mt-8 rounded-md px-5 py-6 sm:px-7">
      <p class="font-mono text-[11px] font-medium leading-[1.4] tracking-normal text-muted-foreground mb-3.5">{c.installLabel[lang]}</p>
      <div class="border-border bg-background focus-within:ring-ring flex w-full flex-wrap items-center gap-x-3 gap-y-2.5 rounded-md border px-3 py-2.5">
        <span class="font-mono text-xs font-medium flex-none select-none text-[color:var(--ah-fg-faint)]">$</span>
        <code class="font-mono font-medium text-foreground/90 min-w-0 flex-1 select-all overflow-x-auto whitespace-nowrap bg-transparent text-[12px]">{c.installCmd}</code>
        <button type="button" data-copy={c.installCmd} class="focus-visible:ring-ring ease-out-quart flex size-[30px] flex-none items-center justify-center rounded-sm transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 motion-reduce:transition-none bg-accent-fill/[0.14] text-primary hover:bg-accent-fill/25">
          <span class="sr-only">{lang === 'zh' ? '复制命令' : 'Copy command'}</span>
          <span class="relative inline-flex size-3.5 items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ease-out-quart absolute size-3.5 transition-all duration-300 scale-100 opacity-100" data-icon-copy><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ease-out-quart absolute size-3.5 transition-all duration-300 scale-50 opacity-0" data-icon-check><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </button>
      </div>
      <p class="font-mono text-[12px] leading-relaxed mt-3 text-[color:var(--ah-fg-muted)]">{c.installNote[lang]}</p>
    </section>

    <!-- Grouped catalog -->
    {providerGroups.map((g) => (
      <section class="mt-12" id={g.sectionId[lang]}>
        <div class="border-border border-t pt-8">
          <div class="grid gap-6 md:grid-cols-[220px_minmax(0,1fr)]">
            <div class="md:sticky md:top-20 md:self-start">
              <p class="font-mono text-[11px] text-muted-foreground mb-1">{g.n}</p>
              <h2 class="text-[1.25rem] font-bold leading-[1.2] tracking-[-0.02em]">{g.label[lang]}</h2>
              <p class="text-[13px] leading-[1.6] mt-2 text-[color:var(--ah-fg-muted)]">{g.desc[lang]}</p>
              <p class="font-mono text-[11px] mt-3 text-muted-foreground">{c.startWith[lang]} <span class="text-foreground">/{g.startWith}</span></p>
            </div>
            <div class="min-w-0">
              {g.items.map((p) => (
                <div class="border-border border-t py-5 first:border-t-0 first:pt-1" id={p.id}>
                  <a href={providerPath(lang, p.id)} class="group block scroll-mt-20">
                    <p class="font-mono text-[11px] leading-[1.4] text-muted-foreground mb-1">{p.id}</p>
                    <div class="flex items-start gap-2">
                      <h3 class="text-[15px] font-semibold leading-[1.3] group-hover:underline underline-offset-4 flex-1 min-w-0">{p.title[lang]}
                        {p.kind !== 'skill' && <span class="font-mono text-[10px] font-medium ml-2 align-middle rounded-sm border border-border px-1 py-px text-muted-foreground">{c.kindLabels[p.kind]}</span>}
                      </h3>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 mt-0.5 shrink-0 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </div>
                  </a>
                  <p class="text-[13px] leading-[1.6] mt-1.5 text-[color:var(--ah-fg-muted)]">{p.oneLine[lang]}</p>
                  <dl class="mt-3 grid gap-2 text-[12px] leading-[1.55]">
                    {p.capabilityId && (
                      <div class="flex gap-2">
                        <dt class="font-mono text-[11px] text-muted-foreground shrink-0 w-[132px]">{c.capabilityLabel[lang]}</dt>
                        <dd><code class="font-mono text-[11.5px] text-foreground bg-foreground/[0.055] border-border/70 rounded-[4px] border px-1.5 py-0.5">{p.capabilityId}</code></dd>
                      </div>
                    )}
                    <div class="flex gap-2">
                      <dt class="font-mono text-[11px] text-muted-foreground shrink-0 w-[132px] pt-0.5">{c.whenLabel[lang]}</dt>
                      <dd class="text-[color:var(--ah-fg-muted)] min-w-0">{p.whenSelected[lang]}</dd>
                    </div>
                    {p.evidence && (
                      <div class="flex gap-2">
                        <dt class="font-mono text-[11px] text-muted-foreground shrink-0 w-[132px] pt-0.5">{c.evidenceLabel[lang]}</dt>
                        <dd class="flex flex-wrap gap-1 min-w-0">
                          {p.evidence.map((alts) => (
                            <span class="inline-flex items-center gap-1">
                              {alts.map((tok, i) => (
                                <>
                                  {i > 0 && <span class="font-mono text-[10px] text-[color:var(--ah-fg-faint)]">|</span>}
                                  <code class="font-mono text-[11px] text-foreground/90 bg-foreground/[0.055] border-border/70 rounded-[4px] border px-1.5 py-0.5">{tok}</code>
                                </>
                              ))}
                            </span>
                          ))}
                        </dd>
                      </div>
                    )}
                  </dl>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- Chain -->
    <section class="mt-14" id="chain">
      <div class="border-border border-t pt-8">
        <h2 class="text-[1.25rem] font-bold leading-[1.2] tracking-[-0.02em] mb-4">{c.chainTitle[lang]}</h2>
        <pre class="bg-muted border-border overflow-x-auto rounded-md border p-5 font-mono text-[12px] leading-[1.8] text-foreground/90">{lang === 'zh' ? CHAIN : CHAIN_EN}</pre>
        <p class="text-[13px] leading-[1.6] mt-3 text-[color:var(--ah-fg-muted)]">{c.chainNote[lang]}</p>
      </div>
    </section>

    <!-- Concept cards -->
    <section class="mt-14" id="concept">
      <div class="border-border border-t pt-8">
        <h2 class="text-[1.25rem] font-bold leading-[1.2] tracking-[-0.02em] mb-5">{c.conceptTitle[lang]}</h2>
        <div class="grid gap-3 sm:grid-cols-3">
          {c.concepts.map((k) => (
            <div class="border-border bg-background rounded-md border p-4">
              <p class="font-mono text-[11px] font-medium text-muted-foreground mb-2">{k.h[lang]}</p>
              <p class="text-[13px] leading-[1.6] text-[color:var(--ah-fg-muted)]">{k.p[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</div>
