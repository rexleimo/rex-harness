---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { docsPath } from '../i18n/docs';

const { lang }: { lang: Lang } = Astro.props;
const INSTALL_CMD = 'npm install -g @rexleimo/rex-harness';
---
<div class="bg-background/95 border-border fixed inset-x-0 bottom-0 z-40 border-t pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden">
  <div class="flex items-center gap-2.5 px-4 py-3">
    <button type="button" data-copy={INSTALL_CMD} class="bg-accent-fill text-accent-fill-foreground hover:bg-accent-fill-hover focus-visible:ring-ring flex h-11 flex-1 items-center justify-center gap-2 rounded-[9px] text-sm font-bold transition-colors">
      <span class="sr-only">{t(lang, 'mobile.copy')}</span>
      <span class="relative inline-flex size-4 items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ease-out-quart absolute size-4 transition-all duration-300 scale-100 opacity-100" data-icon-copy><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ease-out-quart absolute size-4 transition-all duration-300 scale-50 opacity-0" data-icon-check><polyline points="20 6 9 17 4 12"/></svg>
      </span>
      {t(lang, 'mobile.copy')}
    </button>
    <a class="border-input text-[color:var(--ah-fg-subtle)] hover:text-foreground hover:border-foreground/30 focus-visible:ring-ring flex size-11 flex-none items-center justify-center rounded-[9px] border transition-colors" href={docsPath(lang, 'getting-started')} aria-label={t(lang, 'nav.docs')}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
    </a>
  </div>
</div>
